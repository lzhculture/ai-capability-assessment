<view class="container">
  <view wx:if="{{!hasMore}}" class="card empty">
    <view class="empty-t">还没有测评记录</view>
    <view class="muted" style="margin-top: 12rpx;">完成一次测评后, 这里会累积你的能力成长曲线</view>
    <view class="actions" style="justify-content: center;">
      <button class="btn primary" bindtap="goQuiz">去测一次</button>
    </view>
  </view>

  <block wx:else>
    <view class="section-title">总分趋势 (最近 {{trend.length}} 次)</view>
    <view class="card">
      <view class="chart">
        <view wx:for="{{trend}}" wx:key="ts" class="bar-wrap">
          <view class="bar-val">{{item.total}}</view>
          <view class="bar" style="height: {{item.h}};">
            <view class="bar-tag">{{item.levelId}}</view>
          </view>
          <view class="bar-x">{{item.dateShort}}</view>
        </view>
      </view>
      <view class="axis">
        <text>0</text><text>50</text><text>100</text>
      </view>
    </view>

    <view wx:if="{{compare}}" class="section-title">最近两次维度对比</view>
    <view wx:if="{{compare}}" class="card">
      <view class="cmp-hd">
        <text>{{compare.curDate}}</text>
        <text class="vs">对比</text>
        <text class="muted">{{compare.prevDate}}</text>
      </view>
      <view wx:for="{{compare.rows}}" wx:key="id" class="cmp-row">
        <text class="cmp-id">{{item.id}}</text>
        <text class="cmp-name">{{item.name}}</text>
        <text class="cmp-num">{{item.prev}}</text>
        <text class="cmp-arrow">→</text>
        <text class="cmp-num strong">{{item.cur}}</text>
        <text class="cmp-delta {{item.cls}}">{{item.deltaText}}</text>
      </view>
    </view>

    <view class="section-title">全部记录 ({{list.length}})</view>
    <view class="list">
      <view wx:for="{{list}}"
            wx:key="ts"
            class="row-item"
            data-ts="{{item.ts}}"
            bindtap="open">
        <view class="lvl lvl-{{item.levelId}}">{{item.levelId}}</view>
        <view class="info">
          <view class="t">
            {{item.levelName}} · {{item.total}} 分
            <text class="delta {{item.deltaCls}}">{{item.deltaText}}</text>
          </view>
          <view class="m">{{item.packName}} · {{item.qcount}} 题 · {{item.dateStr}} ({{item.agoStr}})</view>
        </view>
        <view class="arrow">›</view>
      </view>
    </view>

    <view class="actions">
      <button class="btn ghost" bindtap="clearAll">清空全部记录</button>
    </view>

    <view class="foot">记录保存在本机微信缓存中, 不上传服务器, 清理微信缓存会一并清除。</view>
  </block>
</view>
