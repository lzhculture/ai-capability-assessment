.container {
  padding: 24rpx 24rpx 80rpx;
  max-width: 720rpx;
  margin: 0 auto;
}

.h {
  font-size: 36rpx;
  font-weight: 800;
  margin: 18rpx 0 12rpx;
  line-height: 1.4;
}

.p {
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.8;
}

.p.small {
  font-size: 24rpx;
  color: var(--muted);
}

.meta {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.meta-cell {
  background: #f7f9ff;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-2);
}

.meta-cell .n {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--brand);
  margin-bottom: 4rpx;
}

/* 维度 */
.dim {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.dim:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.dim-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dim-id {
  background: var(--brand);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.dim-name {
  flex: 1;
  font-weight: 700;
  font-size: 28rpx;
}

.dim-w {
  font-size: 22rpx;
  color: var(--muted);
}

.dim-tagline {
  color: var(--ink-2);
  font-size: 24rpx;
  margin-top: 6rpx;
}

.abil {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.ab {
  background: #f2f5fb;
  color: var(--ink-2);
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
}

/* 等级 */
.lvl-row {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.lvl-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.lvl-badge {
  flex: 0 0 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  color: #fff;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
}

.lvl-badge.lvl-L1 { background: linear-gradient(135deg, #e5484d, #f4706f); }
.lvl-badge.lvl-L2 { background: linear-gradient(135deg, #f0a93b, #f7c469); }
.lvl-badge.lvl-L3 { background: linear-gradient(135deg, #1f5cff, #3b7bff); }
.lvl-badge.lvl-L4 { background: linear-gradient(135deg, #1f9255, #2aaf6a); }

.lvl-name {
  font-weight: 700;
  font-size: 27rpx;
}

.lvl-sub {
  color: var(--muted);
  font-size: 23rpx;
  margin-top: 4rpx;
}

/* 题型 */
.type-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.type-row:last-of-type {
  border-bottom: 0;
}

.type-name {
  font-weight: 700;
  font-size: 26rpx;
}

.type-w {
  background: #eaf0ff;
  color: var(--brand);
  font-size: 21rpx;
  padding: 2rpx 12rpx;
  border-radius: 100rpx;
}

.type-d {
  width: 100%;
  color: var(--muted);
  font-size: 23rpx;
}

/* 隐私 */
.priv {
  padding: 16rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.priv:last-of-type {
  border-bottom: 0;
}

.priv-lbl {
  font-weight: 700;
  font-size: 26rpx;
  margin-bottom: 6rpx;
}

.priv-t {
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 1.7;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.btn.ghost {
  background: transparent;
  border-color: #f3c2c2;
  color: var(--bad);
}

.foot {
  text-align: center;
  color: var(--muted);
  font-size: 22rpx;
  margin-top: 32rpx;
}
