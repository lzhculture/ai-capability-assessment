.container {
  padding: 24rpx 24rpx 200rpx;
  max-width: 720rpx;
  margin: 0 auto;
}

.bar-wrap {
  margin-bottom: 20rpx;
}

.bar-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.bar-meta .pack {
  background: #eaf0ff;
  color: var(--brand);
  padding: 2rpx 14rpx;
  border-radius: 100rpx;
  font-weight: 600;
}

.bar-meta .cnt {
  flex: 1;
}

.card-btn {
  color: var(--brand);
  font-weight: 600;
  border: 1rpx solid #d3e0ff;
  padding: 4rpx 18rpx;
  border-radius: 100rpx;
}

.tip-inline {
  margin-top: 20rpx;
  display: block;
}

/* 底部固定操作条 */
.nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -8rpx 24rpx rgba(31, 92, 255, 0.06);
}

.nav .btn {
  flex: 1;
}

/* 题卡弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 50;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  max-height: 76vh;
  overflow-y: auto;
}

.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sheet-t {
  font-size: 30rpx;
  font-weight: 700;
}

.sheet-x {
  color: var(--brand);
  font-size: 26rpx;
}

.q-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14rpx;
}

.q-cell {
  height: 72rpx;
  border-radius: 12rpx;
  background: #f2f5fb;
  color: var(--ink-2);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
}

.q-cell.done {
  background: #eaf0ff;
  color: var(--brand);
  font-weight: 700;
}

.q-cell.on {
  border-color: var(--brand);
  box-shadow: 0 0 0 4rpx rgba(31, 92, 255, 0.12);
}

.sheet-ft {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.legend {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  background: #f2f5fb;
}

.dot.done {
  background: #eaf0ff;
  border: 1rpx solid var(--brand);
}

.grow {
  flex: 1;
}
