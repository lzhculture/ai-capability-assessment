.container {
  padding: 24rpx;
  max-width: 720rpx;
  margin: 0 auto;
}

.resume {
  background: linear-gradient(135deg, #fff7e6, #fff0c2);
  border: 2rpx solid #f3e3b1;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.resume .b {
  color: #7a5a10;
  font-weight: 700;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 24rpx;
}

.dim-cell {
  background: #f7f9ff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.dim-cell .dim-id {
  display: inline-block;
  background: var(--brand);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.tip {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.tip .tip-lbl {
  background: #f0a93b;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin: 40rpx 0 16rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid var(--brand);
}

.history {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hist-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.hist-lvl {
  flex: 0 0 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #fff;
  font-weight: 800;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 等级配色: 需写在页面 wxss 里才能覆盖 .hist-lvl 的默认渐变 */
.hist-lvl.lvl-L1 { background: linear-gradient(135deg, #e5484d, #f4706f); }
.hist-lvl.lvl-L2 { background: linear-gradient(135deg, #f0a93b, #f7c469); }
.hist-lvl.lvl-L3 { background: linear-gradient(135deg, #1f5cff, #3b7bff); }
.hist-lvl.lvl-L4 { background: linear-gradient(135deg, #1f9255, #2aaf6a); }

.hist-info {
  flex: 1;
  min-width: 0;
}

.hist-t {
  font-weight: 700;
  color: var(--ink);
  font-size: 28rpx;
}

.hist-m {
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.empty {
  text-align: center;
  color: var(--muted);
  background: #f7f9ff;
  border: 2rpx dashed #d4dcef;
}

.actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 32rpx;
}

.btn.ghost {
  background: transparent;
  border-color: #f3c2c2;
  color: var(--bad);
}

.grow {
  flex: 1;
}