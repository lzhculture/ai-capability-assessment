<view wx:if="{{visible}}" class="pp-mask" catchtap="noop">
  <view class="pp-sheet" catchtap="noop">
    <view class="pp-title">{{title}}<text wx:if="{{contractName}}">《{{contractName}}》</text></view>
    <scroll-view scroll-y="true" class="pp-body">
      <view class="pp-text">{{content}}</view>
    </scroll-view>
    <view class="pp-actions">
      <button wx:if="{{showCancel}}" class="pp-btn cancel" bindtap="onCancel">{{cancelText}}</button>
      <button class="pp-btn ok" bindtap="onAgree">{{agreeText}}</button>
    </view>
  </view>
</view>
