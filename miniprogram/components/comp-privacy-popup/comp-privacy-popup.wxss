.pp-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 9999;
}

.pp-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 36rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}

.pp-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}

.pp-body {
  flex: 1;
  max-height: 52vh;
  overflow-y: auto;
}

.pp-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #444;
  white-space: pre-wrap;
}

.pp-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.pp-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: 0;
  padding: 0;
}

.pp-btn.ok {
  background: #1f5cff;
  color: #fff;
}

.pp-btn.cancel {
  background: #f0f2f7;
  color: #666;
}
