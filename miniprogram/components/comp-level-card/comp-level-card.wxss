.lc {
  background: linear-gradient(135deg, #1f5cff, #3b7bff);
  color: #fff;
  border-radius: 36rpx;
  padding: 56rpx 48rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 24rpx 64rpx rgba(31, 92, 255, 0.18);
}

.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  margin-bottom: 24rpx;
}

.lvl-row {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.lvl {
  font-size: 88rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  line-height: 1;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.92;
  margin-bottom: 16rpx;
}

.tip {
  font-size: 24rpx;
  opacity: 0.85;
  line-height: 1.5;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  margin-top: 12rpx;
}

.score {
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 16rpx;
}