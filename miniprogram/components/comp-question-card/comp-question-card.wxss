.qcard {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(31, 92, 255, 0.08);
}

.meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.dim {
  background: #eaf0ff;
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
}

.qid {
  color: var(--muted);
  font-size: 22rpx;
}

.scene {
  background: #f7f9ff;
  border-left: 6rpx solid var(--brand);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.scene .lbl {
  display: block;
  color: var(--brand);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.scene .text {
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
}

.q {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.opts {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.opt {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #fafbff;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  transition: 0.15s;
}

.opt.sel {
  background: linear-gradient(135deg, #eaf0ff, #dde7ff);
  border-color: var(--brand);
}

.opt .badge {
  flex: 0 0 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: var(--brand);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.opt.sel .badge {
  background: var(--brand-2);
}

.opt .text {
  flex: 1;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.55;
}

.analysis {
  margin-top: 24rpx;
  background: #fffbe6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid var(--warn);
}

.analysis .lbl {
  display: block;
  font-size: 20rpx;
  color: #7a5a10;
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.analysis .text {
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.6;
}